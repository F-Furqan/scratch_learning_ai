APP_NAME="Scratch Learning"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_EXTERNAL_ROTATION=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_WORKER_TIMEOUT=120
QUEUE_WORKER_MAX_TIME=3600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password

PAYMENT_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_SANDBOX_API_URL=https://sandbox-api.paddle.com
PADDLE_LIVE_API_URL=https://api.paddle.com
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=5
PADDLE_CHECKOUT_SUCCESS_URL="${APP_URL}/student/dashboard?checkout=success"
PADDLE_CHECKOUT_CANCEL_URL="${APP_URL}/courses?checkout=cancelled"

BACKUPS_ENABLED=false
BACKUP_DRIVER=auto
BACKUP_CONNECTION=
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEOUT_SECONDS=900
BACKUP_VERIFY_DATABASE=scratch-restore-test
BACKUP_FAILURE_MAIL_TO=
MYSQLDUMP_BINARY=mysqldump
MYSQL_CLIENT_BINARY=mysql
BACKUP_MANAGED_PROVIDER=

OPERATIONS_ALERT_MAIL_TO=
OPERATIONS_ALERT_COOLDOWN_MINUTES=15
HEALTH_STORAGE_DISK=local
QUEUE_HEARTBEAT_REQUIRED=true
QUEUE_HEARTBEAT_KEY=operations.queue_heartbeat_at
QUEUE_HEARTBEAT_MAX_AGE_SECONDS=180
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
MONITORING_FAILED_JOBS_THRESHOLD=0
MONITORING_PADDLE_FAILURE_WINDOW_MINUTES=60
MONITORING_PADDLE_STALE_MINUTES=10
MONITORING_BACKUP_MAX_AGE_HOURS=26

MONITORING_SLOW_REQUEST_MS=1000
MONITORING_SLOW_QUERY_MS=250
LOAD_CHECK_PUBLIC_LISTING_MAX_MS=1500
LOAD_CHECK_ADMIN_TABLE_MAX_MS=2000
